# ── Radix Network ─────────────────────────────────────────
RADIX_NETWORK=stokenet                    # stokenet or mainnet
RADIX_GATEWAY_URL=https://stokenet.radixdlt.com

# ── Account & Keys ───────────────────────────────────────
# Server wallet for signing TXs (minting, distributing, faucet)
RADIX_STOKENET_ADDRESS=account_tdx_2_...
RADIX_MAINNET_ADDRESS=account_rdx1...
BOT_PRIVATE_KEY=                           # hex (Secp256k1 default)
BOT_KEY_TYPE=secp256k1                     # or ed25519

# ── dApp Definition ──────────────────────────────────────
# Dedicated MEME GRID dApp Definition account ("MEME GRID"), configured on-chain
# 2026-07-18 via phase1b: account_type="dapp definition",
# claimed_websites=[memegrid.radixguild.com], claimed_entities=[vault/MEME/NFT/package].
# Used by server-side ROLA (server/src/auth/rola.ts) to verify wallet proofs.
RADIX_MAINNET_DAPP_DEF=account_rdx12945s526fxx2c6faj3pykzl6jgl90mhwtnnsgp773r3rp37cstq4lx
RADIX_STOKENET_DAPP_DEF=

# ── Vault v2 badge custody (REQUIRED on mainnet, BEFORE deploy) ──────────
# deploy-meme-token.ts refuses to run on mainnet unless all three are set, are
# valid account addresses, are DISTINCT, and none of them is the deploying key.
# That is deliberate: v1 was left stranded because a single owner badge went
# wherever the deploy transaction dropped it (docs/VAULT-V1-LOST.md).
#
# Nothing is pre-filled on purpose. Whoever deploys supplies THEIR OWN three
# accounts, chosen and confirmed before the deploy; this repository names no
# custody account as a default. The values below are placeholders, not
# addresses, so a mainnet deploy refuses to run while they are left in. The
# badges are placed in one all-or-nothing transaction and then verified
# on-chain (1/1/1 out, 0/0 at the deployer) before the script reports success.
#
#   Owner, cold   — cold custody; the owner badge that can re-point the vault.
VAULT_OWNER_COLD_ACCOUNT=account_rdx1...
#   Owner, backup — different key material (a separate seed), so that losing the
#   cold owner's key is survivable. Keep it boring and untouched.
VAULT_OWNER_BACKUP_ACCOUNT=account_rdx1...
#   Admin         — the warm operations key. Can pause the vault, cannot move funds.
VAULT_ADMIN_ACCOUNT=account_rdx1...

# ── Deployed Addresses (set after deploy-meme-token.ts) ──
VAULT_COMPONENT=                           # component_rdx1... or component_tdx_2_...
MEME_RESOURCE=                             # resource_rdx1... or resource_tdx_2_...
OWNER_BADGE=                               # resource_rdx1... (keep safe!)

# ── NFT Component (set after NFT blueprint deploy) ──────
# NFT_COMPONENT + NFT_MINTER_BADGE are BOTH required for the mint worker to
# start (see config/env.ts). The minter badge must be held by the account in
# RADIX_MAINNET_ADDRESS/RADIX_STOKENET_ADDRESS — the mint manifest creates a
# proof of it from that account.
NFT_COMPONENT=
NFT_RESOURCE=
NFT_MINTER_BADGE=

# ── NFT prize-pool treasury ──────────────────────────────
# Account whose NFT holdings are published as the public prize pool and
# raffled to players. MUST be an account this server holds the key for, or
# raffle sends can't be signed. Verify before setting:
#   virtualAccountAddressFromPublicKey(BOT_PRIVATE_KEY) === NFT_TREASURY_ACCOUNT
# Left blank, the donation call stays hidden (no address is published).
NFT_TREASURY_ACCOUNT=
# Comma-separated resource_rdx1... / resource_tdx_2_... addresses that count as
# prizes. Anything else the treasury holds (e.g. a custody badge) is never
# listed or counted. Empty by default, and empty means NO resource is treated
# as a prize (fails closed). docs/PROJECT-STATE.md item 16.
NFT_PRIZE_RESOURCE_ALLOWLIST=

# ── Guest identities ─────────────────────────────────────
# Guest ids are issued and HMAC-signed by the server (POST /api/guest/new).
# Before that, the browser minted its own `guest_xxxxxxxx` and the server
# accepted it on shape alone — and since the free starting balance is granted
# once per unseen address, clearing sessionStorage minted another 500 MEME,
# without limit.
#
# GUEST_ID_SECRET is the signing key. LEAVING IT BLANK IS SAFE: the server
# generates a random key on first use and keeps it in the `server_secrets`
# table, so a deploy that forgets this var does NOT reopen the faucet. Set it
# when you want a key that survives a DB move or is shared between instances.
# Minimum 16 characters (shorter values are ignored with a warning). Changing
# or clearing it invalidates every outstanding guest session — a tab-scoped
# account, not a wallet, so the cost is a guest starting over.
GUEST_ID_SECRET=

# How many guest sessions one IP may be issued per rolling 24h. This is what
# actually bounds the giveaway: at the default, an IP can collect at most
# 5 x FREE_STARTING_BALANCE per day. Integer, 1..1000. Default: 5.
#
# IPv6 is bucketed by /64, not by address — a subscriber is routinely delegated a
# whole /64, and keying on the full address would give one person 2^64 allowances.
# IPv4 buckets on the exact address.
#
# Raise it if real players share an egress IP (CGNAT on mobile carriers can put
# thousands of unrelated subscribers behind one IPv4 address; the 6th genuine
# guest that day would be refused). Lower it to tighten the giveaway. Changing it
# needs `pm2 restart meme-grid-server --update-env`.
GUEST_MAX_PER_IP_PER_DAY=5

# ── Wallet-address funding (PROJECT-STATE item 14) ───────
# `GET /api/game/:address` funds any address it has not seen before. A Radix
# account address is SELF-ASSERTED — nobody proves ownership while
# ROLA_AUTH_MODE is `legacy` — so this used to be an unbounded faucet: shape
# was the only check, and ~86.4M MEME/day/IP was reachable at the rate limit.
#
# Two mitigations, both on by default, neither a complete fix (per-route ROLA
# is — see open item 3):
#
# 1. bech32m checksum + entity-type + network validation, so fabricated
#    addresses are rejected before they can be funded or reach the NFT mint
#    queue. Set to `false` ONLY as an emergency fallback to the old shape-only
#    behaviour — it reopens a known hole, so record it if you ever do.
ADDRESS_CHECKSUM_ENFORCE=true

# 2. How many NEW account_ addresses one IP may have funded per rolling 24h.
#    Existing players are never gated by this — it meters first-time funding
#    only. Higher than the guest default (5) because owning a Radix wallet is
#    itself a barrier. IPv6 buckets by /64, as with guests.
#    Integer, 1..1000. Default: 10.
ACCOUNT_MAX_NEW_PER_IP_PER_DAY=10

# ── Server ───────────────────────────────────────────────
PORT=3004
ADMIN_TOKEN=                               # for vault/faucet admin endpoints
CORS_ORIGINS=http://localhost:3005,https://memegrid.radixguild.com

# ── Daily Challenge seed ─────────────────────────────────
# Secret mixed into the Daily Challenge board seed (game/grid.ts::getDailySeed).
# Without it, the seed is a bare FNV-1a hash of the UTC date — anyone with
# source access can precompute every day's layout in advance. Leaving this
# unset does NOT crash the server (logs one warning per process instead), so
# it's fine for local/dev. Set it in production before daily rewards carry
# real value. Changing/rotating it only affects boards created AFTER the
# change — already-created boards keep the grid they were dealt.
DAILY_SEED_SALT=

# ── Reward phase ─────────────────────────────────────────
# Phase 1: rewards tracked in DB only. Phase 2: rewards also distributed
# on-chain. Set to `false` to pause accrual so we don't build up DB IOUs
# against an unfunded vault. Default: true.
REWARDS_ENABLED=true

# ── ROLA (Radix Off-Ledger Auth) ─────────────────────────
# Application name sent to Radix Wallet during connect. Shown on the
# "Connecting to …" confirmation screen.
APPLICATION_NAME=MEME GRID

# Comma-separated list of origins accepted in ROLA proofs. The origin
# the client sends must match one of these AND must match what the
# wallet signed over — otherwise the proof is rejected.
ROLA_ALLOWED_ORIGINS=https://memegrid.radixguild.com,http://localhost:3005

# Mode controlling the require-auth middleware during rollout:
#   required — reject any request without a valid session (final state)
#   optional — attach verifiedAddress if token present; else continue
#   legacy   — (default) fall back to trusting req.params.address when
#              no valid session is presented. Log each fallback so we
#              can measure client migration progress. Flip to "required"
#              once all clients are updated.
ROLA_AUTH_MODE=legacy

# ── Frontend (NEXT_PUBLIC_ prefix for client-side access) ─
NEXT_PUBLIC_VAULT_COMPONENT=
NEXT_PUBLIC_MEME_RESOURCE=
NEXT_PUBLIC_DAPP_DEF=
NEXT_PUBLIC_NETWORK=mainnet

# "1" shows a "Phase 1 — rewards tracked, on-chain distribution coming"
# banner in the UI. Set "2" once Phase 2 on-chain distribution is live.
NEXT_PUBLIC_REWARD_PHASE=1

# ── Sentry error tracking ────────────────────────────────
# Leave blank to disable (server boots normally, capture is no-op).
# DSN lives in server/secrets.env on prod (write-only, project-scoped).
SENTRY_DSN=
# Tags for filtering in the Sentry UI. Default: NODE_ENV value.
SENTRY_ENVIRONMENT=production
# Release tag (git sha or package version). Auto-filled from npm_package_version if blank.
SENTRY_RELEASE=
# Fraction of requests traced for perf monitoring (0.0-1.0). Keep low on free tier.
SENTRY_TRACES_SAMPLE_RATE=0.1
