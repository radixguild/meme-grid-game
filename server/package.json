    "@sentry/node": "10.66.0",
    "better-sqlite3": "11.10.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.0.6",
    "@types/node": "20.19.39",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
