# Radix Network
NEXT_PUBLIC_NETWORK=mainnet
# MEME GRID's OWN dApp definition account — "MEME GRID", configured on-chain
# 2026-07-18: account_rdx12945s526fxx2c6faj3pykzl6jgl90mhwtnnsgp773r3rp37cstq4lx
# NEVER the guild's (account_rdx12yh4fw…78z9sq, "Radix Guild") — pointing this at
# the guild makes wallet connect show "Radix Guild" and lets the guild's dApp def
# claim this game's token/NFTs/vault on-chain. The guild value shipped here once;
# that is how the coupling spread.
NEXT_PUBLIC_DAPP_DEF=account_rdx12945s526fxx2c6faj3pykzl6jgl90mhwtnnsgp773r3rp37cstq4lx
NEXT_PUBLIC_VAULT_COMPONENT=
NEXT_PUBLIC_MEME_RESOURCE=
NEXT_PUBLIC_GATEWAY=https://mainnet.radixdlt.com

# Game API
NEXT_PUBLIC_API_URL=https://memegrid.radixguild.com/api

# Server
PORT=3004
CORS_ORIGINS=https://memegrid.radixguild.com
DB_PATH=./data/meme-grid.db
GATEWAY_URL=https://mainnet.radixdlt.com
VAULT_COMPONENT=
MEME_RESOURCE=

# Admin Auth
# ADMIN_TOKEN is set separately (secret). These support token rotation and expiry:
# ISO-8601 datetime or Unix epoch (seconds) when the current ADMIN_TOKEN expires.
# If set, requests after this time are rejected with 401. Invalid values fail closed (500).
ADMIN_TOKEN_EXPIRES_AT=
# Previous admin token — accepted during rotation so deploys don't break live sessions.
# Remove once all clients have switched to the new token.
ADMIN_TOKEN_PREVIOUS=

# ── Gift rails (the tip jar) ────────────────────────────────────────────────
# Both are OPTIONAL and both are OFF until set. /gift 404s and its nav/footer
# links are not rendered while every rail below is empty — there is no separate
# feature flag, because "an address is configured" IS the condition the page
# depends on.
#
# INVALID IS TREATED AS UNSET. Each value is checksum-validated at module load
# (bech32m for Radix, bech32/bech32m for bc1…), and a rejected value logs a
# [gift] warning during `next build` and leaves that rail dark rather than
# rendering something sendable. Read the build output after changing these.
#
# ⚠ NEXT_PUBLIC_* is inlined at BUILD time — setting these and restarting pm2
# does NOT turn the page on. The app must be rebuilt.
#
# ⚠ These are NOT the reward vault. The vault on /tokenomics pays players; these
# go to bigdev. Do not point one at the other.
NEXT_PUBLIC_GIFT_XRD_ADDRESS=
NEXT_PUBLIC_GIFT_BTC_ADDRESS=
